# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
.env.production
.env.staging

# secrets and certs
*.pem
*.key
/secrets/
/certificates/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.worktrees/

# AI/ML artifacts (auto-generated, large binaries)
.fastembed_cache/
graphify-out/

# Local AI tooling session data
.superpowers/

# Admin-only scripts — reveal override mechanisms, keep off public repos
src/scripts/

# Internal planning docs — not relevant to contributors
plans/

# Defensive catch-all for env files; explicit exception for the template
.env*
!.env.example
.gstack/

# Claude Code session-local state (lock files, settings overrides)
.claude/

# Development-only docs (kept local, not for GitHub)
docs/SESSION_HANDOVER.md
docs/PROJECT_STATE.md
docs/QA_AUDIT.md
docs/SUPERADMIN_USER_MANUAL.md
docs/SANITY_CMS_STATE.md
docs/PROJECT_STATE_AND_GAPS.md
docs/USER_TEST_GUIDE.md
docs/pdf/
site-frontend/
site-backend/
nginx/
