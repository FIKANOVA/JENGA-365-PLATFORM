# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
.env.production
.env.staging

# secrets and certs
*.pem
*.key
/secrets/
/certificates/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.worktrees/

# AI/ML artifacts (auto-generated, large binaries)
.fastembed_cache/
graphify-out/

# Local AI tooling session data
.superpowers/

# Scratch, patches, and logs
*.patch
*.diff
*.orig
*.log
patch_*
test-*
test_*
test-results/

# Admin-only and internal seed scripts — reveal override mechanisms, keep off public repos
scripts/seed/
src/scripts/

# Internal planning docs — not relevant to contributors
plans/

# Defensive catch-all for env files; explicit exception for the template
.env*
!.env.example
.gstack/

# Claude Code session-local state (lock files, settings overrides)
.claude/

# Internal engineering & offline documentation
docs/
docs-frontend/
docs-internal-backend/
mkdocs.*.yml
.Jules/
CLAUDE.md
IMPLEMENTATION_PLAN.md
