# Database (Neon)
DATABASE_URL=postgres://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/jenga365?sslmode=require

# Auth (Better Auth)
BETTER_AUTH_SECRET=your-super-secret-32-char-string-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (Social Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Vercel — DO NOT add VERCEL_* vars manually; Vercel injects them automatically.
# REVALIDATE_SECRET is used by ISR cache invalidation endpoints.
REVALIDATE_SECRET=

# AI (Google Gemini + Vercel AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# CMS (Sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=skxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@jenga365.com

# ISR Revalidation Secret
REVALIDATE_SECRET=


# SuperAdmin Bootstrap (never exposed to the client — server-only)
# Must match SUPERADMIN_PASSWORD used when running: npx tsx src/scripts/seed-superadmin-only.ts
# After first login the bootstrap password is replaced; rotate this value if you re-seed.
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=your-bootstrap-password-here
SUPERADMIN_BOOTSTRAP_PASSWORD=your-bootstrap-password-here
SUPERADMIN_NAME=Super Admin

# Sprint B — MEAL Automation
KOBO_WEBHOOK_SECRET=your-32-char-secret-here
CRON_SECRET=your-32-char-secret-here

# Cloudflare Turnstile (Spam Protection)
# For local development, Cloudflare provides dummy test keys that always pass:
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Feedback Form Recipient
FEEDBACK_EMAIL=hello@jenga365.org