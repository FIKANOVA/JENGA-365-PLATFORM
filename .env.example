# Database (Neon PostgreSQL)
DATABASE_URL=postgres://user:password@ep-sample-pool.us-east-2.aws.neon.tech/jenga365?sslmode=require

# Auth (Better Auth)
BETTER_AUTH_SECRET=your-super-secret-32-char-string-here
BETTER_AUTH_URL=https://jenga365.org
NEXT_PUBLIC_APP_URL=https://jenga365.org

# Google OAuth (Social Login)
# In Google Cloud Console, add Authorised JavaScript Origin: https://jenga365.org
# Authorised redirect URI: https://jenga365.org/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Vercel — DO NOT add VERCEL_* vars manually; Vercel injects them automatically.
# REVALIDATE_SECRET is used by ISR cache invalidation endpoints.
REVALIDATE_SECRET=your-secure-revalidation-token-here

# AI (Google Gemini + Vercel AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# CMS (Sanity)
# Add https://jenga365.org to CORS origins at manage.sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=juu4g4fy
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token-here

# Payments (Paystack)
# Set Webhook URL in Paystack Dashboard: https://jenga365.org/api/webhooks/paystack
PAYSTACK_SECRET_KEY=paystack_live_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=paystack_live_public_key_here

# Email (Resend)
# Add and verify domain jenga365.org in Resend Dashboard (DKIM, SPF, MX)
RESEND_API_KEY=resend_api_key_here
RESEND_FROM_EMAIL=Jenga365 <info@jenga365.org>

# Inbound Email Destination (Contact & Feedback form destination)
CONTACT_EMAIL=jengaccclxv@gmail.com
FEEDBACK_EMAIL=jengaccclxv@gmail.com

# SuperAdmin Bootstrap (never exposed to client — server-only)
SUPERADMIN_EMAIL=admin@jenga365.org
SUPERADMIN_PASSWORD=your-secure-superadmin-password-here
SUPERADMIN_NAME=Super Admin

# Sprint B — MEAL Automation
KOBO_WEBHOOK_SECRET=your-32-char-secret-here
CRON_SECRET=your-32-char-secret-here

# Cloudflare Turnstile (Spam Protection)
# In Cloudflare Turnstile Dashboard, add domain: jenga365.org
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key